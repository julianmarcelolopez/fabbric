# Frontend — fabbric
# Solo variables con prefijo VITE_: son las únicas que Vite expone al bundle
# del navegador (todo lo demás del .env.local de la raíz, ej.
# SUPABASE_SECRET_KEY, se ignora acá a propósito). Ninguna de estas 3 es
# secreta — están pensadas para viajar al cliente.
#
# En dev estas viven en el .env.local de la raíz del monorepo (ver
# frontend/vite.config.ts → envDir), no hace falta duplicarlas acá. Este
# archivo es la referencia para cuando el frontend se buildea/deploya aparte
# (Vercel, Netlify, Cloudflare Pages) y no ve el .env.local de la raíz.

VITE_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
# Formato nuevo (reemplaza a la legacy anon key); es pública por diseño
VITE_SUPABASE_ANON_KEY=sb_publishable_...
# URL pública del backend ya deployado — Vite la hornea en el bundle al
# buildear, así que tiene que estar seteada ANTES de correr el build de
# producción (no se puede cambiar después sin rebuildear).
VITE_API_URL=http://localhost:4000
