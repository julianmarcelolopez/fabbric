# Backend — fabbric
# Variables que lee backend/src/config/env.ts en runtime, más las de
# herramientas (migraciones, seed) que no corren en el server pero hacen
# falta para levantarlo. En dev viven todas juntas en el .env.local de la
# raíz del monorepo — este archivo es la referencia para cuando el backend
# se deploya aparte y esas variables se cargan desde el panel del host.

# ── Base de datos (Supabase Postgres) ────────────────────────────────────────
# Runtime: transaction pooler (puerto 6543, host *.pooler.supabase.com)
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-X-<region>.pooler.supabase.com:6543/postgres
# Solo migraciones (drizzle-kit) — conexión directa (puerto 5432, host
# db.*.supabase.co). El server NO la lee en runtime, solo hace falta a mano
# cuando se corre `db:migrate`.
DIRECT_URL=postgresql://postgres:<DB_PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres

# ── Supabase (Auth + Storage) ────────────────────────────────────────────────
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
# Formato nuevo de claves (reemplaza a la legacy service_role) — NUNCA exponer al cliente
SUPABASE_SECRET_KEY=sb_secret_...
# JWT: no hay secreto compartido — el proyecto usa JWT Signing Keys (ES256).
# El backend verifica tokens contra ${SUPABASE_URL}/auth/v1/.well-known/jwks.json

PORT=4000

# ── URLs públicas — importan para deploy ─────────────────────────────────────
# Base del SPA, para armar las back_urls del checkout de Mercado Pago.
# Default si no se setea: http://localhost:5173 — en producción TIENE que ser
# una https:// real, si no Mercado Pago no habilita auto_return (el checkout
# sigue funcionando pero el comprador no vuelve solo a la tienda al pagar).
FRONTEND_URL=http://localhost:5173
# URL pública de este mismo backend, para que Mercado Pago mande el webhook de
# pago acá. Sin esto, los pagos nunca confirman solos (no se manda
# notification_url a MP). En dev se usa un túnel (cloudflared); en producción
# es la URL real del backend deployado.
# MP_WEBHOOK_URL=https://tu-backend-deployado.com

# ── Mercado Pago (T6) ─────────────────────────────────────────────────────────
# Credenciales de PRUEBA de la app (panel nuevo: también empiezan con APP_USR-;
# distinguirlas por la página "Credenciales de prueba" /credentials/sandbox)
MP_ACCESS_TOKEN=APP_USR-...
# Secret del webhook (se genera al configurar la URL del webhook — T6 tarea 7)
# MP_WEBHOOK_SECRET=
# SOLO dev/test — simula pagos sin pegarle a la API real de MP. JAMÁS en producción.
# MP_FAKE_PAYMENTS=true

# ── Resend (T7: emails de cambio de estado) ──────────────────────────────────
# Opcional: sin key, los emails se loguean en vez de enviarse (modo degradado)
# RESEND_API_KEY=re_...
# EMAIL_FROM=fabbric <onboarding@resend.dev>   (dev; en prod, dominio propio verificado)

# ── Seed de desarrollo (solo lo usa `npm run db:seed`, no el server) ─────────
SEED_ADMIN_EMAIL=owner@example.com
SEED_ADMIN_PASSWORD=...
SEED_SUPERADMIN_EMAIL=super@example.com
SEED_SUPERADMIN_PASSWORD=...

# ── Cifrado de credenciales de MP por org (T16) ──────────────────────────────
# 32 bytes en base64 (ej. `openssl rand -base64 32`). Opcional — sin ella, la
# tab Integraciones no funciona, pero el resto del sistema sigue andando.
# ENCRYPTION_KEY=

# ── Nota de deploy ────────────────────────────────────────────────────────────
# El origen permitido de CORS se lee de FRONTEND_URL (backend/src/index.ts) —
# ya no está hardcodeado, alcanza con setear esa variable arriba.
